# Copy this file to .env and fill in your own keys (only needed when running on your own server).
# On GitHub the same names are set as repository secrets. Never commit the real .env file.
DATABENTO_API_KEY=
ANTHROPIC_API_KEY=
# Email alerts
ALERT_EMAIL_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
# Tradovate (see README: "Connecting Tradovate")
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=TradingDesk
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
